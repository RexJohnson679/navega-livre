{
  "manifest_version": 3,
  "name": "Navega Livre",
  "version": "0.3.0",
  "description": "Bloqueio local de publicidade e rastreadores, ajustes do YouTube e avisos de bloqueador em sites compatíveis.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "filter-info.js",
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Navega Livre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "filter-info.js",
        "common.js",
        "youtube-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "filter-info.js",
        "common.js",
        "content.js"
      ],
      "css": [
        "cosmetic.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "advertising",
        "enabled": true,
        "path": "rules/advertising.json"
      },
      {
        "id": "privacy",
        "enabled": true,
        "path": "rules/privacy.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "navega-livre@local.extension",
      "strict_min_version": "128.0"
    }
  }
}
