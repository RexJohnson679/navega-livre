{
  "manifest_version": 3,
  "name": "Navega Livre",
  "version": "0.1.0",
  "description": "Bloqueio local de publicidade, ajustes do YouTube e avisos de bloqueador em sites compatíveis.",
  "browser_specific_settings": {
    "gecko": {
      "id": "navega-livre@local.extension",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Navega Livre",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}